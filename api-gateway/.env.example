# Rules:
# - CHANGEABLE: You can set/change this for your environment.
# - UNIQUE SOURCE: Must come from provider-issued credentials, secrets manager, or generated secret material.

# Core runtime [CHANGEABLE]
DATABASE_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CORS_ORIGIN=http://localhost:3001
CORE_ENGINE_HTTP_URL=http://127.0.0.1:8000
PULSECORE_GRPC_URL=localhost:50051
ENTERPRISE_SERVICE_URL=http://127.0.0.1:8080

# Auth/JWT [UNIQUE SOURCE for secrets, CHANGEABLE for TTL]
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_MFA_SECRET=
MFA_ENCRYPTION_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_MFA_TTL_SECONDS=300

# OAuth (user auth) [UNIQUE SOURCE]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# OAuth (connector installs) [UNIQUE SOURCE for client secrets/ids, CHANGEABLE for URLs/age]
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=
GITHUB_CONNECTOR_CLIENT_ID=
GITHUB_CONNECTOR_CLIENT_SECRET=
NOTION_CONNECTOR_CLIENT_ID=
NOTION_CONNECTOR_CLIENT_SECRET=
API_PUBLIC_BASE_URL=http://127.0.0.1:3000
DASHBOARD_PUBLIC_BASE_URL=http://127.0.0.1:3001
CONNECTOR_OAUTH_STATE_SECRET=
CONNECTOR_OAUTH_STATE_MAX_AGE_MS=600000

# Email/notifications [UNIQUE SOURCE for provider creds/webhooks, CHANGEABLE for URLs/from-address]
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=noreply@pulsegrid.dev
FRONTEND_URL=http://127.0.0.1:3001
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=

# Billing/market [UNIQUE SOURCE for Stripe secret, CHANGEABLE for region/return URLs]
STRIPE_SECRET_KEY=
STRIPE_CONNECT_COUNTRY=US
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings?tab=billing
DASHBOARD_URL=http://localhost:3000

# Security/rate limits/ops [UNIQUE SOURCE for keys/secrets, CHANGEABLE for limits and local URLs]
MANAGEMENT_API_KEY=
WEBHOOK_MAX_SKEW_SECONDS=300
RATE_LIMIT_REGISTER_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=30
RATE_LIMIT_VERIFICATION_EMAIL_PER_MINUTE=5
RATE_LIMIT_OAUTH_PER_MINUTE=60
RATE_LIMIT_TRIGGER_PER_MINUTE=120
RATE_LIMIT_SECRET_WRITES_PER_MINUTE=30
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
DEPLOYMENT_SHA=local
CONNECTOR_CATALOG_URL=http://127.0.0.1:3000/connectors/catalog
CLICKHOUSE_URL=
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
