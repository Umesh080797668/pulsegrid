# Rules:
# - CHANGEABLE: You can set/change this for your environment.
# - UNIQUE SOURCE: Must come from provider-issued credentials, secrets manager, or generated secret material.

# Required to boot [CHANGEABLE for local DB, UNIQUE SOURCE in shared/prod]
DATABASE_URL=

# Core runtime [UNIQUE SOURCE for signing secret, CHANGEABLE for URL/salt/deployment marker]
REDIS_URL=redis://127.0.0.1:6379/
PULSE_WEBHOOK_SIGNING_SECRET=
PULSE_WEBHOOK_SIGNING_SALT=pulsegrid_webhook_salt
DEPLOYMENT_SHA=local

# Workspace vault/HSM [UNIQUE SOURCE]
PULSE_HSM_ESCROW_URL=
PULSE_HSM_ESCROW_TOKEN=

# Billing/stripe [UNIQUE SOURCE]
STRIPE_SECRET_KEY=
PRO_MONTHLY_PRICE_ID=
PRO_YEARLY_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Approvals/notifications [UNIQUE SOURCE for webhook/emails, CHANGEABLE for link base]
SLACK_WEBHOOK_URL=
APPROVAL_SLACK_WEBHOOK_URL=
APPROVAL_LINK_BASE=http://127.0.0.1:3001
APPROVAL_EMAIL_TO=
ALERT_EMAIL_TO=
FLOW_FAILURE_NOTIFY_EMAIL=

# Email provider [UNIQUE SOURCE for API key, CHANGEABLE for from address]
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@pulsegrid.local

# Analytics [UNIQUE SOURCE]
CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=
CLICKHOUSE_DB_STAGING=

# Operations/tuning [CHANGEABLE]
APPROVAL_EXPIRY_SWEEP_SECONDS=60
HEALTH_CHECK_INTERVAL_SECONDS=30
