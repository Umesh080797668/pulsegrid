# Rules:
# - CHANGEABLE: You can set/change this for your environment.
# - UNIQUE SOURCE: Must come from provider-issued credentials, secrets manager, or generated secret material.

# Server [CHANGEABLE]
ENTERPRISE_SERVICE_PORT=8080

# Database [CHANGEABLE for local/dev; UNIQUE SOURCE if using managed DB credentials]
DATABASE_URL=jdbc:h2:file:./data/enterprise;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DATABASE_TO_LOWER=TRUE
DB_USER=sa
DB_PASSWORD=1234
DB_DRIVER=org.h2.Driver
DB_POOL_SIZE=10
DB_MIN_IDLE=2
JPA_DATABASE_PLATFORM=org.hibernate.dialect.H2Dialect
JPA_DDL_AUTO=validate

# Redis [CHANGEABLE]
REDIS_HOST=localhost
REDIS_PORT=6379

# GDPR [CHANGEABLE for placeholders/paths, UNIQUE SOURCE for auth token]
GDPR_EXPORT_DIRECTORY=./data/gdpr-exports
GDPR_PLACEHOLDER_USER_EMAIL=gdpr-erased@pulsegrid.invalid
GDPR_PLACEHOLDER_USER_FULL_NAME=GDPR Erased Account
GDPR_PLACEHOLDER_USER_AVATAR_URL=https://ui-avatars.com/api/?name=GDPR+Erased+Account&background=0f172a&color=ffffff&size=256&bold=true
GDPR_HSM_ESCROW_PURGE_URL=http://localhost:9099
GDPR_HSM_ESCROW_AUTH_TOKEN=
