{
  "name": "@pulsegrid/sdk",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/pulsegrid-sdk.min.js",
  "module": "./dist/pulsegrid-sdk.es.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/pulsegrid-sdk.es.js",
      "require": "./dist/pulsegrid-sdk.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "semantic-release": "^25.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-dts": "^5.0.0",
    "vue-tsc": "^3.2.7"
  },
  "release": {
    "branches": ["main"]
  }
}
